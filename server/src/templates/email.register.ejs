<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Welcome to Time Table</title>
  </head>

  <body
    style="
      margin: 0;
      padding: 0;
      background: #f5f5f5;
      font-family: Arial, sans-serif;
    "
  >
    <table
      width="100%"
      cellpadding="0"
      cellspacing="0"
      style="padding: 40px 16px"
    >
      <tr>
        <td align="center">
          <table
            width="100%"
            cellpadding="0"
            cellspacing="0"
            style="
              max-width: 520px;
              background: #ffffff;
              border-radius: 24px;
              overflow: hidden;
              border: 1px solid #e5e5e5;
              box-shadow: 0 10px 30px rgba(0, 0, 0, 0.08);
            "
          >
            <!-- Header -->
            <tr>
              <td
                align="center"
                style="padding: 36px 32px 20px; background: #111111"
              >
                <h1
                  style="
                    margin: 0;
                    color: #ffffff;
                    font-size: 30px;
                    font-weight: 700;
                    letter-spacing: -0.5px;
                  "
                >
                  Time Table
                </h1>

                <p style="margin: 10px 0 0; color: #a1a1aa; font-size: 14px">
                  Account registration successful
                </p>
              </td>
            </tr>

            <!-- Body -->
            <tr>
              <td style="padding: 40px 32px">
                <h2
                  style="
                    margin: 0;
                    color: #111827;
                    font-size: 26px;
                    text-align: center;
                  "
                >
                  Welcome, <%= userName %> 🎉
                </h2>

                <p
                  style="
                    margin: 14px 0 0;
                    color: #6b7280;
                    font-size: 15px;
                    line-height: 1.7;
                    text-align: center;
                  "
                >
                  Thank you for joining Time Table. Your account has been
                  created successfully and is ready to use.
                </p>

                <!-- User Details -->
                <table
                  width="100%"
                  cellpadding="0"
                  cellspacing="0"
                  style="margin: 36px 0"
                >
                  <tr>
                    <td align="center">
                      <div
                        style="
                          background: #fafafa;
                          border: 1px solid #e5e7eb;
                          border-radius: 18px;
                          padding: 24px;
                          text-align: left;
                        "
                      >
                        <p
                          style="
                            margin: 0 0 12px;
                            color: #111827;
                            font-size: 15px;
                          "
                        >
                          <strong>Username:</strong> <%= userName %>
                        </p>

                        <p style="margin: 0; color: #111827; font-size: 15px">
                          <strong>Email:</strong> <%= email %>
                        </p>
                      </div>
                    </td>
                  </tr>
                </table>

                <!-- Welcome Message -->
                <div
                  style="
                    background: #fafafa;
                    border: 1px solid #e5e7eb;
                    border-radius: 16px;
                    padding: 18px;
                  "
                >
                  <p
                    style="
                      margin: 0;
                      color: #52525b;
                      font-size: 14px;
                      line-height: 1.8;
                      text-align: center;
                    "
                  >
                    You can now sign in and start managing your schedules,
                    classes, and activities efficiently.
                  </p>
                </div>

                <p
                  style="
                    margin: 28px 0 0;
                    text-align: center;
                    color: #9ca3af;
                    font-size: 12px;
                    line-height: 1.7;
                  "
                >
                  If you did not create this account, please contact our support
                  team immediately.
                </p>
              </td>
            </tr>

            <!-- Footer -->
            <tr>
              <td
                align="center"
                style="
                  border-top: 1px solid #f1f5f9;
                  padding: 20px;
                  background: #fafafa;
                "
              >
                <p style="margin: 0; font-size: 12px; color: #9ca3af">
                  © 2026 Time Table. All rights reserved.
                </p>
              </td>
            </tr>
          </table>
        </td>
      </tr>
    </table>
  </body>
</html>
